{
  "name": "colonizers-of-windamere",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/bots/sim.ts",
    "pt:serve": "tsx scripts/playtest/serve.ts",
    "pt": "tsx scripts/playtest/cli.ts",
    "dev:server": "vite build && wrangler dev",
    "e2e:server": "tsx scripts/e2e-server.ts",
    "deploy:cf": "tsc --noEmit && vite build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "1.63.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
